# --- report: count atoms that left the slab through +z (sputtered) -----
variable        z_escape equal 54.31+15.0
variable        is_escaped atom "z > v_z_escape"
group           g_escaped variable is_escaped
0 atoms in group g_escaped
variable        n_sputtered equal count(g_escaped)
print           "SPUTTER_YIELD_RESULT n_sputtered=${n_sputtered} energy=100.0 angle=0.0 seed=1"
SPUTTER_YIELD_RESULT n_sputtered=0 energy=100.0 angle=0.0 seed=1

write_dump      all custom test100.final.dump id type x y z vx vy vz c_pe_atom
