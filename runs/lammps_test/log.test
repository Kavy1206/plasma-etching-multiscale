# --- fire the projectile -----------------------------------------------
variable        cx equal (bound(all,xmin)+bound(all,xmax))/2 + 0.0
variable        cy equal (bound(all,ymin)+bound(all,ymax))/2 + 0.0
variable        launch_z equal 62.31

create_atoms    2 single ${cx} ${cy} ${launch_z} units box
create_atoms    2 single 21.7203392785095 ${cy} ${launch_z} units box
create_atoms    2 single 21.7203392785095 21.7281322556433 ${launch_z} units box
create_atoms    2 single 21.7203392785095 21.7281322556433 62.31 units box
Created 1 atoms
  using box units in orthogonal box = (0 0 0) to (43.448 43.448 81.465)
  create_atoms CPU = 0.000 seconds
group           g_projectile type 2
1 atoms in group g_projectile

variable        speed_mps equal sqrt(2*100.0*1.602176634e-19/(39.948*1.66053906660e-27))
variable        speed_A_ps equal v_speed_mps*1.0e-2      # m/s -> Angstrom/ps (metal units)
variable        vz0 equal -v_speed_A_ps*cos(0.0*PI/180)
variable        vx0 equal  v_speed_A_ps*sin(0.0*PI/180)

velocity        g_projectile set ${vx0} 0.0 ${vz0} units box
velocity        g_projectile set 0 0.0 ${vz0} units box
velocity        g_projectile set 0 0.0 -219.785038572832 units box
fix             fproj g_projectile nve

# --- variable timestep: small during the cascade, larger once it settles
fix             fdt all dt/reset 1 0.0001 0.002 0.02 units box

compute         pe_atom all pe/atom
thermo          100
thermo_style    custom step dt temp pe ke etotal
dump            d1 all custom 200 test100.dump id type x y z vx vy vz c_pe_atom

run             1500
